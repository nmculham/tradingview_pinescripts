//@version=6
indicator('Daily Key Levels', overlay=true)

// text size options for the labels
txt_sizeopt = input.string(title="Text Size", defval="normal", inline = "10", options = ["auto", "tiny", "small", "normal", "large", "huge"], group ='Label')
txt_size = (txt_sizeopt == "auto") ? size.auto : (txt_sizeopt == "tiny") ? size.tiny : (txt_sizeopt == "small") ? size.small : (txt_sizeopt == "normal") ? size.normal : (txt_sizeopt == "large") ? size.large : size.huge

// define time settings
secondBool= input.bool(true, title='Seconds', group='Price axis visibility', inline='second')
minuteBool= input.bool(true, title='Minutes', group='Price axis visibility', inline='minute')
hourBool= input.bool(true, title='Hours', group='Price axis visibility', inline='hour')
dayBool = input.bool(false, title='Days', group='Price axis visibility', inline='day')
weekBool= input.bool(false, title='Weeks', group='Price axis visibility', inline='week')
monthBool = input.bool(false, title='Months', group='Price axis visibility', inline='month')

secondMin = input.int(1, '', 1, 59, group='Price axis visibility', inline='second')
secondMax = input.int(59, '-', 1, 59, group='Price axis visibility', inline='second')
minuteMin = input.int(1, '', 1, 59, group='Price axis visibility', inline='minute')
minuteMax = input.int(59, '-', 1, 59, group='Price axis visibility', inline='minute')
hourMin = input.int(1, '', 1, 24, group='Price axis visibility', inline='hour')
hourMax = input.int(24, '-', 1, 24, group='Price axis visibility', inline='hour')
dayMin= input.int(1, '', 1, 366, group='Price axis visibility', inline='day')
dayMax= input.int(366, '-', 1, 366, group='Price axis visibility', inline='day')
weekMin = input.int(1, '', 1, 52, group='Price axis visibility', inline='week')
weekMax = input.int(52, '-', 1, 52, group='Price axis visibility', inline='week')
monthMin= input.int(1, '', 1, 12, group='Price axis visibility', inline='month')
monthMax= input.int(12, '-', 1, 12, group='Price axis visibility', inline='month')

timeframeNumberstr = str.match(timeframe.period, '[0-9]*')
timeframeNumber = str.tonumber(timeframeNumberstr)
timeframeLetter = str.match(timeframe.period, '[A-Z]')

bool timeframePlot = false

if secondBool and timeframeLetter=='S' and secondMin<=timeframeNumber and secondMax>=timeframeNumber
    timeframePlot := true
if minuteBool and timeframeLetter=='' and minuteMin<=timeframeNumber and minuteMax>=timeframeNumber
    timeframePlot := true
if hourBool and timeframeLetter=='' and hourMin*60<=timeframeNumber and hourMax*60>=timeframeNumber
    timeframePlot := true
if dayBool and timeframeLetter=='D' and dayMin<=timeframeNumber and dayMax>=timeframeNumber
    timeframePlot := true
if weekBool and timeframeLetter=='W' and weekMin<=timeframeNumber and weekMax>=timeframeNumber
    timeframePlot := true
if monthBool and timeframeLetter=='M' and monthMin<=timeframeNumber and monthMax>=timeframeNumber
    timeframePlot := true

// ═══════════════════════════════════════════════
// KEY LEVELS GROUP
// ═══════════════════════════════════════════════
showKeyLevels = input.bool(true, title="Show Key Level Lines & Labels", group="Key Levels")

// Colours
YHOD_Colour = input(title='YHOD', defval=color.rgb(255, 165, 0), group='Key Levels', inline='YHOD')
YLOD_Colour = input(title='YLOD', defval=color.rgb(255, 165, 0), group='Key Levels', inline='YLOD')
PMH_Colour  = input(title='PMH',  defval=color.rgb(0, 200, 255), group='Key Levels', inline='PMH')
PML_Colour  = input(title='PML',  defval=color.rgb(0, 200, 255), group='Key Levels', inline='PML')
TDH_Colour  = input(title='TDH',  defval=color.rgb(180, 0, 255), group='Key Levels', inline='TDH')
TDL_Colour  = input(title='TDL',  defval=color.rgb(180, 0, 255), group='Key Levels', inline='TDL')

// Line widths
YHOD_LineWidth = input(1, 'Thickness', group='Key Levels', inline='YHOD')
YLOD_LineWidth = input(1, 'Thickness', group='Key Levels', inline='YLOD')
PMH_LineWidth  = input(1, 'Thickness', group='Key Levels', inline='PMH')
PML_LineWidth  = input(1, 'Thickness', group='Key Levels', inline='PML')
TDH_LineWidth  = input(1, 'Thickness', group='Key Levels', inline='TDH')
TDL_LineWidth  = input(1, 'Thickness', group='Key Levels', inline='TDL')

// Line styles
YHOD_StyleOpt = input.string('dashed (╌)', title='', options=['solid (─)','dotted (..)','dashed (╌)'], group='Key Levels', inline='YHOD')
YLOD_StyleOpt = input.string('dashed (╌)', title='', options=['solid (─)','dotted (..)','dashed (╌)'], group='Key Levels', inline='YLOD')
PMH_StyleOpt  = input.string('dotted (..)', title='', options=['solid (─)','dotted (..)','dashed (╌)'], group='Key Levels', inline='PMH')
PML_StyleOpt  = input.string('dotted (..)', title='', options=['solid (─)','dotted (..)','dashed (╌)'], group='Key Levels', inline='PML')
TDH_StyleOpt  = input.string('solid (─)',   title='', options=['solid (─)','dotted (..)','dashed (╌)'], group='Key Levels', inline='TDH')
TDL_StyleOpt  = input.string('solid (─)',   title='', options=['solid (─)','dotted (..)','dashed (╌)'], group='Key Levels', inline='TDL')

YHOD_LineStyle = YHOD_StyleOpt == 'dotted (..)' ? line.style_dotted : YHOD_StyleOpt == 'dashed (╌)' ? line.style_dashed : line.style_solid
YLOD_LineStyle = YLOD_StyleOpt == 'dotted (..)' ? line.style_dotted : YLOD_StyleOpt == 'dashed (╌)' ? line.style_dashed : line.style_solid
PMH_LineStyle  = PMH_StyleOpt  == 'dotted (..)' ? line.style_dotted : PMH_StyleOpt  == 'dashed (╌)' ? line.style_dashed : line.style_solid
PML_LineStyle  = PML_StyleOpt  == 'dotted (..)' ? line.style_dotted : PML_StyleOpt  == 'dashed (╌)' ? line.style_dashed : line.style_solid
TDH_LineStyle  = TDH_StyleOpt  == 'dotted (..)' ? line.style_dotted : TDH_StyleOpt  == 'dashed (╌)' ? line.style_dashed : line.style_solid
TDL_LineStyle  = TDL_StyleOpt  == 'dotted (..)' ? line.style_dotted : TDL_StyleOpt  == 'dashed (╌)' ? line.style_dashed : line.style_solid

// Show in price axis
YHOD_PriceAxis = input.bool(true, title='YHOD price axis', group='Key Levels')
YLOD_PriceAxis = input.bool(true, title='YLOD price axis', group='Key Levels')
PMH_PriceAxis  = input.bool(true, title='PMH price axis',  group='Key Levels')
PML_PriceAxis  = input.bool(true, title='PML price axis',  group='Key Levels')
TDH_PriceAxis  = input.bool(true, title='TDH price axis',  group='Key Levels')
TDL_PriceAxis  = input.bool(true, title='TDL price axis',  group='Key Levels')

// Label offset
KL_LabelOffset = input.int(7, title='Label offset from last bar', group='Key Levels')

// var declarations
var line YHOD_Line = na
var line YLOD_Line = na
var line PMH_Line  = na
var line PML_Line  = na
var line TDH_Line  = na
var line TDL_Line  = na

var label YHOD_Label = na
var label YLOD_Label = na
var label PMH_Label  = na
var label PML_Label  = na
var label TDH_Label  = na
var label TDL_Label  = na

var float YHOD_val = na
var float YLOD_val = na
var float PMH_val  = na
var float PML_val  = na
var float TDH_val  = na
var float TDL_val  = na

var int YHOD_bar = na
var int YLOD_bar = na
var int PMH_bar  = na
var int PML_bar  = na
var int TDH_bar  = na
var int TDL_bar  = na

// Internal tracking — records which bar set the regular session high/low (for YHOD/YLOD/TDH/TDL)
// Resets on the first regular session bar of each new calendar day
var int   today_high_bar     = na
var int   today_low_bar      = na
var float today_high_tracked = na
var float today_low_tracked  = na
var int   today_day_tracked  = na

// Internal tracking — overnight session (prev after-hours + today pre-market) for PMH/PML
var float ovn_high     = na  // running overnight high
var float ovn_low      = na  // running overnight low
var int   ovn_high_bar = na
var int   ovn_low_bar  = na
var float pmh_frozen   = na  // frozen at regular session open
var float pml_frozen   = na
var int   pmh_fbar     = na
var int   pml_fbar     = na

// ── Key Level Values ──────────────────────────────────────────
// Yesterday High/Low of Day  (previous daily session)
YHOD_val := request.security(syminfo.tickerid, "1D", high[1],  lookahead=barmerge.lookahead_on)
YLOD_val := request.security(syminfo.tickerid, "1D", low[1],   lookahead=barmerge.lookahead_on)

// Today's High/Low  (current session)
TDH_val  := request.security(syminfo.tickerid, "1D", high, lookahead=barmerge.lookahead_on)
TDL_val  := request.security(syminfo.tickerid, "1D", low,  lookahead=barmerge.lookahead_on)

// YHOD/YLOD/TDH/TDL tracking: resets on the first REGULAR SESSION bar of each new calendar day
// Using session.ismarket + dayofmonth change avoids session.isfirstbar firing at pre-market
is_first_reg_bar = session.ismarket and (na(today_day_tracked) or dayofmonth != today_day_tracked)
if is_first_reg_bar
    if not na(today_high_bar)
        YHOD_bar := today_high_bar
        YLOD_bar := today_low_bar
    today_day_tracked  := dayofmonth
    today_high_tracked := high
    today_low_tracked  := low
    today_high_bar     := bar_index
    today_low_bar      := bar_index
    TDH_bar            := bar_index
    TDL_bar            := bar_index
else if session.ismarket
    if high >= today_high_tracked
        today_high_tracked := high
        today_high_bar     := bar_index
        TDH_bar            := bar_index
    if low <= today_low_tracked
        today_low_tracked  := low
        today_low_bar      := bar_index
        TDL_bar            := bar_index

// PMH/PML: overnight session = previous day after-hours + today pre-market
// Accumulates silently during session.ispostmarket and session.ispremarket
// Frozen at the first regular session bar (same trigger as YHOD/YLOD)
// Always displays frozen values — never updates during after-hours
if is_first_reg_bar
    pmh_frozen := ovn_high
    pml_frozen := ovn_low
    pmh_fbar   := ovn_high_bar
    pml_fbar   := ovn_low_bar
    ovn_high     := na
    ovn_low      := na
    ovn_high_bar := na
    ovn_low_bar  := na

if session.ispostmarket or session.ispremarket
    if na(ovn_high) or high >= ovn_high
        ovn_high     := high
        ovn_high_bar := bar_index
    if na(ovn_low) or low <= ovn_low
        ovn_low     := low
        ovn_low_bar := bar_index

PMH_val := pmh_frozen
PML_val := pml_frozen
PMH_bar := pmh_fbar
PML_bar := pml_fbar

// delete existing lines and labels so they don't clutter the chart
line.delete(YHOD_Line)
label.delete(YHOD_Label)
line.delete(YLOD_Line)
label.delete(YLOD_Label)
line.delete(PMH_Line)
label.delete(PMH_Label)
line.delete(PML_Line)
label.delete(PML_Label)
line.delete(TDH_Line)
label.delete(TDH_Label)
line.delete(TDL_Line)
label.delete(TDL_Label)

if showKeyLevels and timeframe.isintraday
    YHOD_Line  := line.new(x1=YHOD_bar, y1=YHOD_val, x2=bar_index+10, y2=YHOD_val, color=YHOD_Colour, style=YHOD_LineStyle, width=YHOD_LineWidth, extend=extend.none)
    YHOD_Label := label.new(bar_index + KL_LabelOffset, YHOD_val, text='YHOD ' + str.tostring(YHOD_val, format.mintick), color=YHOD_Colour, style=label.style_none, textcolor=YHOD_Colour, size=txt_size)

    YLOD_Line  := line.new(x1=YLOD_bar, y1=YLOD_val, x2=bar_index+10, y2=YLOD_val, color=YLOD_Colour, style=YLOD_LineStyle, width=YLOD_LineWidth, extend=extend.none)
    YLOD_Label := label.new(bar_index + KL_LabelOffset, YLOD_val, text='YLOD ' + str.tostring(YLOD_val, format.mintick), color=YLOD_Colour, style=label.style_none, textcolor=YLOD_Colour, size=txt_size)

    PMH_Line  := line.new(x1=PMH_bar, y1=PMH_val, x2=bar_index+10, y2=PMH_val, color=PMH_Colour, style=PMH_LineStyle, width=PMH_LineWidth, extend=extend.none)
    PMH_Label := label.new(bar_index + KL_LabelOffset, PMH_val, text='PMH ' + str.tostring(PMH_val, format.mintick), color=PMH_Colour, style=label.style_none, textcolor=PMH_Colour, size=txt_size)

    PML_Line  := line.new(x1=PML_bar, y1=PML_val, x2=bar_index+10, y2=PML_val, color=PML_Colour, style=PML_LineStyle, width=PML_LineWidth, extend=extend.none)
    PML_Label := label.new(bar_index + KL_LabelOffset, PML_val, text='PML ' + str.tostring(PML_val, format.mintick), color=PML_Colour, style=label.style_none, textcolor=PML_Colour, size=txt_size)

    TDH_Line  := line.new(x1=TDH_bar, y1=TDH_val, x2=bar_index+10, y2=TDH_val, color=TDH_Colour, style=TDH_LineStyle, width=TDH_LineWidth, extend=extend.none)
    TDH_Label := label.new(bar_index + KL_LabelOffset, TDH_val, text='TDH ' + str.tostring(TDH_val, format.mintick), color=TDH_Colour, style=label.style_none, textcolor=TDH_Colour, size=txt_size)

    TDL_Line  := line.new(x1=TDL_bar, y1=TDL_val, x2=bar_index+10, y2=TDL_val, color=TDL_Colour, style=TDL_LineStyle, width=TDL_LineWidth, extend=extend.none)
    TDL_Label := label.new(bar_index + KL_LabelOffset, TDL_val, text='TDL ' + str.tostring(TDL_val, format.mintick), color=TDL_Colour, style=label.style_none, textcolor=TDL_Colour, size=txt_size)

    label.set_x(YHOD_Label, bar_index + KL_LabelOffset)
    label.set_x(YLOD_Label, bar_index + KL_LabelOffset)
    label.set_x(PMH_Label,  bar_index + KL_LabelOffset)
    label.set_x(PML_Label,  bar_index + KL_LabelOffset)
    label.set_x(TDH_Label,  bar_index + KL_LabelOffset)
    label.set_x(TDL_Label,  bar_index + KL_LabelOffset)

plot(showKeyLevels and timeframe.isintraday and YHOD_PriceAxis and timeframePlot ? YHOD_val : na, color=YHOD_Colour, editable=false, display=display.price_scale)
plot(showKeyLevels and timeframe.isintraday and YLOD_PriceAxis and timeframePlot ? YLOD_val : na, color=YLOD_Colour, editable=false, display=display.price_scale)
plot(showKeyLevels and timeframe.isintraday and PMH_PriceAxis  and timeframePlot ? PMH_val  : na, color=PMH_Colour,  editable=false, display=display.price_scale)
plot(showKeyLevels and timeframe.isintraday and PML_PriceAxis  and timeframePlot ? PML_val  : na, color=PML_Colour,  editable=false, display=display.price_scale)
plot(showKeyLevels and timeframe.isintraday and TDH_PriceAxis  and timeframePlot ? TDH_val  : na, color=TDH_Colour,  editable=false, display=display.price_scale)
plot(showKeyLevels and timeframe.isintraday and TDL_PriceAxis  and timeframePlot ? TDL_val  : na, color=TDL_Colour,  editable=false, display=display.price_scale)
