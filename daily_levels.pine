var line EMA4_TF3Line = na
var line EMA1_TF4Line = na
var line EMA2_TF4Line = na
var line EMA3_TF4Line = na
var line EMA4_TF4Line = na

var line YHOD_Line = na
var line YLOD_Line = na
var line PMH_Line  = na
var line PML_Line  = na
var line TDH_Line  = na
var line TDL_Line  = na

var label YHOD_Label = na
var label YLOD_Label = na
var label PMH_Label  = na
var label PML_Label  = na
var label TDH_Label  = na
var label TDL_Label  = na

var float YHOD_val = na
var float YLOD_val = na
var float PMH_val  = na
var float PML_val  = na
var float TDH_val  = na
var float TDL_val  = na

var int YHOD_bar = na
var int YLOD_bar = na
var int PMH_bar  = na
var int PML_bar  = na
var int TDH_bar  = na
var int TDL_bar  = na

// Internal tracking — records which bar set the regular session high/low (for YHOD/YLOD/TDH/TDL)
// Resets on the first regular session bar of each new calendar day
var int   today_high_bar     = na
var int   today_low_bar      = na
var float today_high_tracked = na
var float today_low_tracked  = na
var int   today_day_tracked  = na

// Internal tracking — overnight session (prev after-hours + today pre-market) for PMH/PML
var float ovn_high     = na  // running overnight high
var float ovn_low      = na  // running overnight low
var int   ovn_high_bar = na
var int   ovn_low_bar  = na
var float pmh_frozen   = na  // frozen at regular session open
var float pml_frozen   = na
var int   pmh_fbar     = na
var int   pml_fbar     = na

var label EMA1_TF1Label = na
var label EMA2_TF1Label = na
var label EMA3_TF1Label = na
var label EMA4_TF1Label = na
var label EMA1_TF2Label = na
var label EMA2_TF2Label = na
var label EMA3_TF2Label = na
var label EMA4_TF2Label = na
var label EMA1_TF3Label = na
var label EMA2_TF3Label = na
var label EMA3_TF3Label = na
var label EMA4_TF3Label = na
var label EMA1_TF4Label = na
var label EMA2_TF4Label = na
var label EMA3_TF4Label = na
var label EMA4_TF4Label = na

var float EMA1_TF1_val = na
var float EMA2_TF1_val = na
var float EMA3_TF1_val = na
var float EMA4_TF1_val = na
var float EMA1_TF2_val = na
var float EMA2_TF2_val = na
var float EMA3_TF2_val = na
var float EMA4_TF2_val = na
var float EMA1_TF3_val = na
var float EMA2_TF3_val = na
var float EMA3_TF3_val = na
var float EMA4_TF3_val = na
var float EMA1_TF4_val = na
var float EMA2_TF4_val = na
var float EMA3_TF4_val = na
var float EMA4_TF4_val = na

var int bar_index_open = na

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// find price level for each time frame/ema value that was selected by the user
EMA1_TF1_val := request.security(syminfo.tickerid, EMA_TF1_tf, ta.ema(src,EMA1_TF1))
EMA2_TF1_val := request.security(syminfo.tickerid, EMA_TF1_tf, ta.ema(src,EMA2_TF1))
EMA3_TF1_val := request.security(syminfo.tickerid, EMA_TF1_tf, ta.ema(src,EMA3_TF1))
EMA4_TF1_val := request.security(syminfo.tickerid, EMA_TF1_tf, ta.ema(src,EMA4_TF1))
EMA1_TF2_val := request.security(syminfo.tickerid, EMA_TF2_tf, ta.ema(src,EMA1_TF2))
EMA2_TF2_val := request.security(syminfo.tickerid, EMA_TF2_tf, ta.ema(src,EMA2_TF2))
EMA3_TF2_val := request.security(syminfo.tickerid, EMA_TF2_tf, ta.ema(src,EMA3_TF2))
EMA4_TF2_val := request.security(syminfo.tickerid, EMA_TF2_tf, ta.ema(src,EMA4_TF2))
EMA1_TF3_val := request.security(syminfo.tickerid, EMA_TF3_tf, ta.ema(src,EMA1_TF3))
EMA2_TF3_val := request.security(syminfo.tickerid, EMA_TF3_tf, ta.ema(src,EMA2_TF3))
EMA3_TF3_val := request.security(syminfo.tickerid, EMA_TF3_tf, ta.ema(src,EMA3_TF3))
EMA4_TF3_val := request.security(syminfo.tickerid, EMA_TF3_tf, ta.ema(src,EMA4_TF3))
EMA1_TF4_val := request.security(syminfo.tickerid, EMA_TF4_tf, ta.ema(src,EMA1_TF4))
EMA2_TF4_val := request.security(syminfo.tickerid, EMA_TF4_tf, ta.ema(src,EMA2_TF4))
EMA3_TF4_val := request.security(syminfo.tickerid, EMA_TF4_tf, ta.ema(src,EMA3_TF4))
EMA4_TF4_val := request.security(syminfo.tickerid, EMA_TF4_tf, ta.ema(src,EMA4_TF4))

// ── Key Level Values ──────────────────────────────────────────
// Yesterday High/Low of Day  (previous daily session)
YHOD_val := request.security(syminfo.tickerid, "1D", high[1],  lookahead=barmerge.lookahead_on)
YLOD_val := request.security(syminfo.tickerid, "1D", low[1],   lookahead=barmerge.lookahead_on)

// Today's High/Low  (current session)
TDH_val  := request.security(syminfo.tickerid, "1D", high, lookahead=barmerge.lookahead_on)
TDL_val  := request.security(syminfo.tickerid, "1D", low,  lookahead=barmerge.lookahead_on)

// YHOD/YLOD/TDH/TDL tracking: resets on the first REGULAR SESSION bar of each new calendar day
// Using session.ismarket + dayofmonth change avoids session.isfirstbar firing at pre-market
is_first_reg_bar = session.ismarket and (na(today_day_tracked) or dayofmonth != today_day_tracked)
if is_first_reg_bar
    if not na(today_high_bar)
        YHOD_bar := today_high_bar
        YLOD_bar := today_low_bar
    today_day_tracked  := dayofmonth
    today_high_tracked := high
    today_low_tracked  := low
    today_high_bar     := bar_index
    today_low_bar      := bar_index
    TDH_bar            := bar_index
    TDL_bar            := bar_index
else if session.ismarket
    if high >= today_high_tracked
        today_high_tracked := high
        today_high_bar     := bar_index
        TDH_bar            := bar_index
    if low <= today_low_tracked
        today_low_tracked  := low
        today_low_bar      := bar_index
        TDL_bar            := bar_index

// PMH/PML: overnight session = previous day after-hours + today pre-market
// Accumulates silently during session.ispostmarket and session.ispremarket
// Frozen at the first regular session bar (same trigger as YHOD/YLOD)
// Always displays frozen values — never updates during after-hours
if is_first_reg_bar
    pmh_frozen := ovn_high
    pml_frozen := ovn_low
    pmh_fbar   := ovn_high_bar
    pml_fbar   := ovn_low_bar
    ovn_high     := na
    ovn_low      := na
    ovn_high_bar := na
    ovn_low_bar  := na

if session.ispostmarket or session.ispremarket
    if na(ovn_high) or high >= ovn_high
        ovn_high     := high
        ovn_high_bar := bar_index
    if na(ovn_low) or low <= ovn_low
        ovn_low     := low
        ovn_low_bar := bar_index

PMH_val := pmh_frozen
PML_val := pml_frozen
PMH_bar := pmh_fbar
PML_bar := pml_fbar

// This updated function now accepts user-defined colors for the difference text
f_addTableRow(tableId, row, name, value, rawDiff, bgColor, nameValueTextColor, posDiffColorParam, negDiffColorParam, textSize) =>
    // Determine color for the 'Difference' column using the new parameters
    diffColor = rawDiff >= 0 ? posDiffColorParam : negDiffColorParam
    
    // Column 1: EMA Name
    table.cell(tableId, 0, row, name, bgcolor = bgColor, text_color = nameValueTextColor, text_halign=text.align_left, text_size = textSize)
    // Column 2: EMA Price
    table.cell(tableId, 1, row, value, bgcolor = bgColor, text_color = nameValueTextColor, text_halign = text.align_right, text_size = textSize)
    // Column 3: Price Difference
    table.cell(tableId, 2, row, str.tostring(rawDiff, format.mintick), bgcolor = bgColor, text_color = diffColor, text_halign = text.align_right, text_size = textSize)


// Custom function to sort the EmaInfo array (Corrected Final Version)
sortEmaArrayByValue(EmaInfo[] arr, bool isDescending) =>
    int n = array.size(arr)
    if n > 1
        for i = 0 to n - 2
            for j = 0 to n - i - 2
                EmaInfo element_j = array.get(arr, j)
                EmaInfo element_j1 = array.get(arr, j + 1)
                
                // Use the boolean to decide the comparison logic
                bool shouldSwap = isDescending ? element_j.value < element_j1.value : element_j.value > element_j1.value

                if shouldSwap
                    array.set(arr, j, element_j1)
                    array.set(arr, j + 1, element_j)
    arr // Return the modified array

// NEW -- Final Table logic with selectable background color modes
if showTable
    // 1. Create an array to hold all EMA info objects
    EmaInfo[] emaDataArray = array.new<EmaInfo>()

    // 2. Populate the array with the data for ALL 16 EMAs (using line color as the default background)
    array.push(emaDataArray, EmaInfo.new(EMA1_TF1_name, EMA1_TF1_val, EMA1_TF1Colour))
    array.push(emaDataArray, EmaInfo.new(EMA2_TF1_name, EMA2_TF1_val, EMA2_TF1Colour))
    array.push(emaDataArray, EmaInfo.new(EMA3_TF1_name, EMA3_TF1_val, EMA3_TF1Colour))
    array.push(emaDataArray, EmaInfo.new(EMA4_TF1_name, EMA4_TF1_val, EMA4_TF1Colour))
    array.push(emaDataArray, EmaInfo.new(EMA1_TF2_name, EMA1_TF2_val, EMA1_TF2Colour))
    array.push(emaDataArray, EmaInfo.new(EMA2_TF2_name, EMA2_TF2_val, EMA2_TF2Colour))
    array.push(emaDataArray, EmaInfo.new(EMA3_TF2_name, EMA3_TF2_val, EMA3_TF2Colour))
    array.push(emaDataArray, EmaInfo.new(EMA4_TF2_name, EMA4_TF2_val, EMA4_TF2Colour))
    array.push(emaDataArray, EmaInfo.new(EMA1_TF3_name, EMA1_TF3_val, EMA1_TF3Colour))
    array.push(emaDataArray, EmaInfo.new(EMA2_TF3_name, EMA2_TF3_val, EMA2_TF3Colour))
    array.push(emaDataArray, EmaInfo.new(EMA3_TF3_name, EMA3_TF3_val, EMA3_TF3Colour))
    array.push(emaDataArray, EmaInfo.new(EMA4_TF3_name, EMA4_TF3_val, EMA4_TF3Colour))
    array.push(emaDataArray, EmaInfo.new(EMA1_TF4_name, EMA1_TF4_val, EMA1_TF4Colour))
    array.push(emaDataArray, EmaInfo.new(EMA2_TF4_name, EMA2_TF4_val, EMA2_TF4Colour))
    array.push(emaDataArray, EmaInfo.new(EMA3_TF4_name, EMA3_TF4_val, EMA3_TF4Colour))
    array.push(emaDataArray, EmaInfo.new(EMA4_TF4_name, EMA4_TF4_val, EMA4_TF4Colour))

// Key Levels — added to table so they sort in price context with EMAs
    if showKeyLevelsInTable
        array.push(emaDataArray, EmaInfo.new("YHOD", YHOD_val, YHOD_Colour))
        array.push(emaDataArray, EmaInfo.new("YLOD", YLOD_val, YLOD_Colour))
        array.push(emaDataArray, EmaInfo.new("PMH",  PMH_val,  PMH_Colour))
        array.push(emaDataArray, EmaInfo.new("PML",  PML_val,  PML_Colour))
        array.push(emaDataArray, EmaInfo.new("TDH",  TDH_val,  TDH_Colour))
        array.push(emaDataArray, EmaInfo.new("TDL",  TDL_val,  TDL_Colour))

    // 3. If "Ordered" is selected, add the current price to the array to be sorted
    if tableLayout == "Ordered"
        array.push(emaDataArray, EmaInfo.new("--- CURRENT PRICE ---", close, currPriceRowBgColor))
        sortEmaArrayByValue(emaDataArray, true)

    // 3b. NEW -- If "Price Comparison" mode is selected, override the background colors
    if rowBgColorMode == "Price Diff."
        for i = 0 to array.size(emaDataArray) - 1
            EmaInfo currentItem = array.get(emaDataArray, i)
            // Only change EMA rows, not the special "Current Price" row
            if currentItem.name != "--- CURRENT PRICE ---"
                color newBgColor = currentItem.value >= close ? bgColorAbove : bgColorBelow
                currentItem.rowColor := newBgColor // Update the color in the object

    // 4. Initialize and clear the table
    var table emaTable = table.new(tablePosition, 3, 26, border_width = 1) 
    table.clear(emaTable, 0, 0, 2, 25) 

    // 5. Draw the headers
    table.cell(emaTable, 0, 0, 'Moving Average', bgcolor = headerBgColor, text_color = headerTextColor, text_halign=text.align_center, text_size = tableTextSize)
    table.cell(emaTable, 1, 0, 'Price', bgcolor = headerBgColor, text_color = headerTextColor, text_halign=text.align_center, text_size = tableTextSize)
    table.cell(emaTable, 2, 0, 'Difference', bgcolor = headerBgColor, text_color = headerTextColor, text_halign=text.align_center, text_size = tableTextSize)
    
    // 6. Loop through the array and build the table rows
    for i = 0 to array.size(emaDataArray) - 1
        EmaInfo currentItem = array.get(emaDataArray, i)
        
        string name = currentItem.name
        string valueStr = str.tostring(currentItem.value, format.mintick)
        float diff = 0.0
        color nameValueTextColor = emaRowTextColor

        if name == "--- CURRENT PRICE ---"
            diff := 0.0 
            nameValueTextColor := currPriceRowTextColor
        else
            diff := currentItem.value - close

        f_addTableRow(emaTable, i + 1, name, valueStr, diff, currentItem.rowColor, nameValueTextColor, posDiffColor, negDiffColor, tableTextSize)




// based on setting chosen adjust start point of where line will be drawn
if session.isfirstbar and levelSetting=='a'
    bar_index_open := bar_index
if levelSetting=='b'
