    label.set_x(EMA2_TF3Label, bar_index + EMA2_TF3Offset)
    label.set_x(EMA3_TF3Label, bar_index + EMA3_TF3Offset)
    label.set_x(EMA4_TF3Label, bar_index + EMA4_TF3Offset)
    label.set_x(EMA1_TF4Label, bar_index + EMA1_TF4Offset) 
    label.set_x(EMA2_TF4Label, bar_index + EMA2_TF4Offset)
    label.set_x(EMA3_TF4Label, bar_index + EMA3_TF4Offset)
    label.set_x(EMA4_TF4Label, bar_index + EMA4_TF4Offset)

    if showKeyLevels
        label.set_x(YHOD_Label, bar_index + KL_LabelOffset)
        label.set_x(YLOD_Label, bar_index + KL_LabelOffset)
        label.set_x(PMH_Label,  bar_index + KL_LabelOffset)
        label.set_x(PML_Label,  bar_index + KL_LabelOffset)
        label.set_x(TDH_Label,  bar_index + KL_LabelOffset)
        label.set_x(TDL_Label,  bar_index + KL_LabelOffset)

// plotting the label only (no lines)
plot(showDrawings and timeframe.isintraday and EMA1_TF1Price and timeframePlot ? EMA1_TF1_val : na, color=EMA1_TF1Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA2_TF1Price and timeframePlot ? EMA2_TF1_val : na, color=EMA2_TF1Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA3_TF1Price and timeframePlot ? EMA3_TF1_val : na, color=EMA3_TF1Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA4_TF1Price and timeframePlot ? EMA4_TF1_val : na, color=EMA4_TF1Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA1_TF2Price and timeframePlot ? EMA1_TF2_val : na, color=EMA1_TF2Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA2_TF2Price and timeframePlot ? EMA2_TF2_val : na, color=EMA2_TF2Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA3_TF2Price and timeframePlot ? EMA3_TF2_val : na, color=EMA3_TF2Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA4_TF2Price and timeframePlot ? EMA4_TF2_val : na, color=EMA4_TF2Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA1_TF3Price and timeframePlot ? EMA1_TF3_val : na, color=EMA1_TF3Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA2_TF3Price and timeframePlot ? EMA2_TF3_val : na, color=EMA2_TF3Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA3_TF3Price and timeframePlot ? EMA3_TF3_val : na, color=EMA3_TF3Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA4_TF3Price and timeframePlot ? EMA4_TF3_val : na, color=EMA4_TF3Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA1_TF4Price and timeframePlot ? EMA1_TF4_val : na, color=EMA1_TF4Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA2_TF4Price and timeframePlot ? EMA2_TF4_val : na, color=EMA2_TF4Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA3_TF4Price and timeframePlot ? EMA3_TF4_val : na, color=EMA3_TF4Colour, editable=false, display=display.price_scale)
plot(showDrawings and timeframe.isintraday and EMA4_TF4Price and timeframePlot ? EMA4_TF4_val : na, color=EMA4_TF4Colour, editable=false, display=display.price_scale)

plot(showDrawings and showKeyLevels and timeframe.isintraday and YHOD_PriceAxis and timeframePlot ? YHOD_val : na, color=YHOD_Colour, editable=false, display=display.price_scale)
plot(showDrawings and showKeyLevels and timeframe.isintraday and YLOD_PriceAxis and timeframePlot ? YLOD_val : na, color=YLOD_Colour, editable=false, display=display.price_scale)
plot(showDrawings and showKeyLevels and timeframe.isintraday and PMH_PriceAxis  and timeframePlot ? PMH_val  : na, color=PMH_Colour,  editable=false, display=display.price_scale)
plot(showDrawings and showKeyLevels and timeframe.isintraday and PML_PriceAxis  and timeframePlot ? PML_val  : na, color=PML_Colour,  editable=false, display=display.price_scale)
plot(showDrawings and showKeyLevels and timeframe.isintraday and TDH_PriceAxis  and timeframePlot ? TDH_val  : na, color=TDH_Colour,  editable=false, display=display.price_scale)
plot(showDrawings and showKeyLevels and timeframe.isintraday and TDL_PriceAxis  and timeframePlot ? TDL_val  : na, color=TDL_Colour,  editable=false, display=display.price_scale)

// alert settings (cannot use dynamic values in alert setting :( for more info: https://www.tradingcode.net/tradingview/program-alerts/ )
//EMA1_TF1_title = str.tostring(EMA1_TF1) + ' EMA TF1 cross'
// variables that will "find" when price crosses the line (both up and down) . Will return True upon crossing
EMA1_TF1_cross = ta.cross(close,EMA1_TF1_val)
EMA2_TF1_cross = ta.cross(close,EMA2_TF1_val)
EMA3_TF1_cross = ta.cross(close,EMA3_TF1_val)
EMA4_TF1_cross = ta.cross(close,EMA4_TF1_val)
EMA1_TF2_cross = ta.cross(close,EMA1_TF2_val)
EMA2_TF2_cross = ta.cross(close,EMA2_TF2_val)
EMA3_TF2_cross = ta.cross(close,EMA3_TF2_val)
EMA4_TF2_cross = ta.cross(close,EMA4_TF2_val)
EMA1_TF3_cross = ta.cross(close,EMA1_TF3_val) 
EMA2_TF3_cross = ta.cross(close,EMA2_TF3_val)
EMA3_TF3_cross = ta.cross(close,EMA3_TF3_val)
EMA4_TF3_cross = ta.cross(close,EMA4_TF3_val)
EMA1_TF4_cross = ta.cross(close,EMA1_TF4_val)
EMA2_TF4_cross = ta.cross(close,EMA2_TF4_val)
EMA3_TF4_cross = ta.cross(close,EMA3_TF4_val)
EMA4_TF4_cross = ta.cross(close,EMA4_TF4_val)

// when above variables are "True" alert will go off. Also define title of alert and default alert message when triggered. 
alertcondition(EMA1_TF1_cross, title='TF1 EMA 1 cross', message='Price crossed TF1 EMA 1!')
alertcondition(EMA2_TF1_cross, title='TF1 EMA 2 cross', message='Price crossed TF1 EMA 2!')
alertcondition(EMA3_TF1_cross, title='TF1 EMA 3 cross', message='Price crossed TF1 EMA 3!')
alertcondition(EMA4_TF1_cross, title='TF1 EMA 4 cross', message='Price crossed TF1 EMA 4!')
alertcondition(EMA1_TF2_cross, title='TF2 EMA 1 cross', message='Price crossed TF2 EMA 1!')
alertcondition(EMA2_TF2_cross, title='TF2 EMA 2 cross', message='Price crossed TF2 EMA 2!')
alertcondition(EMA3_TF2_cross, title='TF2 EMA 3 cross', message='Price crossed TF2 EMA 3!')
alertcondition(EMA4_TF2_cross, title='TF2 EMA 4 cross', message='Price crossed TF2 EMA 4!')
alertcondition(EMA1_TF3_cross, title='TF3 EMA 1 cross', message='Price crossed TF3 EMA 1!')
alertcondition(EMA2_TF3_cross, title='TF3 EMA 2 cross', message='Price crossed TF3 EMA 2!')
alertcondition(EMA3_TF3_cross, title='TF3 EMA 3 cross', message='Price crossed TF3 EMA 3!')
alertcondition(EMA4_TF3_cross, title='TF3 EMA 4 cross', message='Price crossed TF3 EMA 4!')
alertcondition(EMA1_TF4_cross, title='TF4 EMA 1 cross', message='Price crossed TF4 EMA 1!')
alertcondition(EMA2_TF4_cross, title='TF4 EMA 2 cross', message='Price crossed TF4 EMA 2!')
alertcondition(EMA3_TF4_cross, title='TF4 EMA 3 cross', message='Price crossed TF4 EMA 3!')
alertcondition(EMA4_TF4_cross, title='TF4 EMA 4 cross', message='Price crossed TF4 EMA 4!')


