// Indicator that will show a horizontal line on where each EMA are on different time frame, which will remove the effort of having to flick through different time frame.
// the price gap between each of the lines are known as "air gaps", which are essentially zones price can move with less resistance.
// Therefore bigger the airgap more reward can be expected on trades made. 


//@version=6
indicator('Air Gap MTF + OD values + alert settings + Table', overlay=true)

// Custom data type to hold all info for one EMA row
// Updated custom data type to hold the user-defined name
type EmaInfo
    string name
    float value
    color rowColor

// define variables that sets EMA values for each of the timeframe. Each timeframe has 4 EMA values to set, which can be changed in the settings.
src = input(title="Source", defval=hl2, group='EMA settings')
// Let user choose a timeframe from a dropdown list
EMA_TF1_tf = input.timeframe("30", title="Timeframe 1 (TF1)", group='EMA settings')
EMA1_TF1 = input.int(title="TF1 EMA 1",defval=5, group='EMA settings')
EMA2_TF1 = input.int(title="TF1 EMA 2", defval=12, group='EMA settings')
EMA3_TF1 = input.int(title="TF1 EMA 3", defval=34, group='EMA settings')
EMA4_TF1 = input.int(title="TF1 EMA 4", defval=50, group='EMA settings')
EMA_TF2_tf = input.timeframe("60", title="Timeframe 2 (TF2)", group='EMA settings')
EMA1_TF2 = input.int(title="TF2 EMA 1",defval=5, group='EMA settings')
EMA2_TF2 = input.int(title="TF2 EMA 2", defval=12, group='EMA settings')
EMA3_TF2 = input.int(title="TF2 EMA 3", defval=34, group='EMA settings')
EMA4_TF2 = input.int(title="TF2 EMA 4", defval=50, group='EMA settings')
EMA_TF3_tf = input.timeframe("240", title="Timeframe 3 (TF3)", group='EMA settings')
EMA1_TF3 = input.int(title="TF3 EMA 1",defval=5, group='EMA settings')
EMA2_TF3 = input.int(title="TF3 EMA 2", defval=12, group='EMA settings')
EMA3_TF3 = input.int(title="TF3 EMA 3", defval=34, group='EMA settings')
EMA4_TF3 = input.int(title="TF3 EMA 4", defval=50, group='EMA settings')
EMA_TF4_tf = input.timeframe("1D", title="Timeframe 4 (TF4)", group='EMA settings')
EMA1_TF4 = input.int(title="TF4 EMA 1",defval=5, group='EMA settings')
EMA2_TF4 = input.int(title="TF4 EMA 2", defval=12, group='EMA settings')
EMA3_TF4 = input.int(title="TF4 EMA 3", defval=34, group='EMA settings')
EMA4_TF4 = input.int(title="TF4 EMA 4", defval=50, group='EMA settings')

// set options on where to draw the lines. This can be chosen in the settings by the user.
levelSettingOption = input.string('Draw from Day Start', title='Display', options=['Draw from Day Start', 'Draw from specified offset', 'Draw across the chart'], group='Price level')
levelSetting = levelSettingOption == 'Draw from Day Start' ? 'a' : levelSettingOption == 'Draw across the chart' ? 'c' : 'b'
EMA_LineOffset = input.int(defval = -25, title='Line start point offset from last bar', group='Price level')

//Variables to set where the lines will be drawn, based on the price level
// Add this line with your other inputs under the 'Price level' group
showDrawings = input.bool(true, title="Show Lines & Labels", group="Price level")
EMA1_TF1Level = input.bool(true, title='TF1 EMA 1', group='Price level', inline='EMA1_TF1')
EMA2_TF1Level= input.bool(true, title='TF1 EMA 2', group='Price level', inline='EMA2_TF1')
EMA3_TF1Level= input.bool(true, title='TF1 EMA 3', group='Price level', inline='EMA3_TF1')
EMA4_TF1Level = input.bool(true, title='TF1 EMA 4', group='Price level', inline='EMA4_TF1')
EMA1_TF2Level = input.bool(true, title='TF2 EMA 1', group='Price level', inline='EMA1_TF2')
