// alert settings (cannot use dynamic values in alert setting :( for more info: https://www.tradingcode.net/tradingview/program-alerts/ )
//EMA1_TF1_title = str.tostring(EMA1_TF1) + ' EMA TF1 cross'
// variables that will "find" when price crosses the line (both up and down) . Will return True upon crossing
EMA1_TF1_cross = ta.cross(close,EMA1_TF1_val)
EMA2_TF1_cross = ta.cross(close,EMA2_TF1_val)
EMA3_TF1_cross = ta.cross(close,EMA3_TF1_val)
EMA4_TF1_cross = ta.cross(close,EMA4_TF1_val)
EMA1_TF2_cross = ta.cross(close,EMA1_TF2_val)
EMA2_TF2_cross = ta.cross(close,EMA2_TF2_val)
EMA3_TF2_cross = ta.cross(close,EMA3_TF2_val)
EMA4_TF2_cross = ta.cross(close,EMA4_TF2_val)
EMA1_TF3_cross = ta.cross(close,EMA1_TF3_val) 
EMA2_TF3_cross = ta.cross(close,EMA2_TF3_val)
EMA3_TF3_cross = ta.cross(close,EMA3_TF3_val)
EMA4_TF3_cross = ta.cross(close,EMA4_TF3_val)
EMA1_TF4_cross = ta.cross(close,EMA1_TF4_val)
EMA2_TF4_cross = ta.cross(close,EMA2_TF4_val)
EMA3_TF4_cross = ta.cross(close,EMA3_TF4_val)
EMA4_TF4_cross = ta.cross(close,EMA4_TF4_val)

// when above variables are "True" alert will go off. Also define title of alert and default alert message when triggered. 
alertcondition(EMA1_TF1_cross, title='TF1 EMA 1 cross', message='Price crossed TF1 EMA 1!')
alertcondition(EMA2_TF1_cross, title='TF1 EMA 2 cross', message='Price crossed TF1 EMA 2!')
alertcondition(EMA3_TF1_cross, title='TF1 EMA 3 cross', message='Price crossed TF1 EMA 3!')
alertcondition(EMA4_TF1_cross, title='TF1 EMA 4 cross', message='Price crossed TF1 EMA 4!')
alertcondition(EMA1_TF2_cross, title='TF2 EMA 1 cross', message='Price crossed TF2 EMA 1!')
alertcondition(EMA2_TF2_cross, title='TF2 EMA 2 cross', message='Price crossed TF2 EMA 2!')
alertcondition(EMA3_TF2_cross, title='TF2 EMA 3 cross', message='Price crossed TF2 EMA 3!')
alertcondition(EMA4_TF2_cross, title='TF2 EMA 4 cross', message='Price crossed TF2 EMA 4!')
alertcondition(EMA1_TF3_cross, title='TF3 EMA 1 cross', message='Price crossed TF3 EMA 1!')
alertcondition(EMA2_TF3_cross, title='TF3 EMA 2 cross', message='Price crossed TF3 EMA 2!')
alertcondition(EMA3_TF3_cross, title='TF3 EMA 3 cross', message='Price crossed TF3 EMA 3!')
alertcondition(EMA4_TF3_cross, title='TF3 EMA 4 cross', message='Price crossed TF3 EMA 4!')
alertcondition(EMA1_TF4_cross, title='TF4 EMA 1 cross', message='Price crossed TF4 EMA 1!')
alertcondition(EMA2_TF4_cross, title='TF4 EMA 2 cross', message='Price crossed TF4 EMA 2!')
alertcondition(EMA3_TF4_cross, title='TF4 EMA 3 cross', message='Price crossed TF4 EMA 3!')
alertcondition(EMA4_TF4_cross, title='TF4 EMA 4 cross', message='Price crossed TF4 EMA 4!')


